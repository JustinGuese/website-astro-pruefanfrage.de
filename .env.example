# Formspree form IDs — create these in your Formspree account (https://formspree.io)
# Distinct endpoints keep the funnel rungs separable for manual triage. Within an
# endpoint, the hidden `tier` field (see src/components/TrackingFields.astro)
# records which offer box a submission came from.
PUBLIC_FORMSPREE_BLOCK_A_ID=REPLACE_WITH_FORMSPREE_ID     # Starthilfe (free templates, €0)
PUBLIC_FORMSPREE_FALL_ID=REPLACE_WITH_FORMSPREE_ID        # Stufe 1 case upload (incl. Block B)
PUBLIC_FORMSPREE_BESTELLUNG_ID=REPLACE_WITH_FORMSPREE_ID  # Paid orders: Notfallkit €19 + Human-Check €390
PUBLIC_FORMSPREE_KONTAKT_ID=REPLACE_WITH_FORMSPREE_ID     # Stufe 3 / Pilot / general contact

# Every form also carries first-touch attribution (utm_*, fbclid/gclid, referrer),
# stamped client-side by the script in src/layouts/Site.astro. Nothing to configure —
# just append ?utm_source=…&utm_campaign=… to the ad's destination URL.
