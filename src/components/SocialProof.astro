---
/**
 * ⚠️  PROTOTYPE PLACEHOLDER CONTENT — NOT REAL CUSTOMERS.
 *
 * The quotes and counters below are invented to validate the funnel layout
 * before real references exist. Publishing invented testimonials on a live
 * commercial site is irreführende Werbung under §5 UWG and can be abmahnt.
 *
 * Before this domain takes real traffic, either:
 *   a) replace every entry with a genuine, documented customer statement, or
 *   b) set PLACEHOLDER_PROOF = false to remove the section entirely.
 *
 * Attribution is deliberately role + region only (no invented person names,
 * no invented company names) to keep the placeholder as low-risk as possible.
 */
const PLACEHOLDER_PROOF = true;

const stimmen = [
  {
    az: 'AZ. PG-114',
    quote:
      'Der MD hatte uns bei drei Klienten herabgestuft. Wir haben die Entwürfe am selben Tag rausgeschickt — bei zweien blieb der Pflegegrad stehen.',
    role: 'Pflegedienstleitung',
    context: 'Ambulanter Pflegedienst · ~140 Klienten · NRW',
    metric: '2 von 3 Herabstufungen abgewendet',
  },
  {
    az: 'AZ. §275-078',
    quote:
      'Vorher hat die Geschäftsführung einen halben Tag pro Prüfanfrage verbrannt. Jetzt sind es 40 Minuten Durchsicht — und wir haben endlich Quellenverweise in der Akte.',
    role: 'Geschäftsführung',
    context: 'Stationäre Pflege · 2 Häuser · Bayern',
    metric: 'von ~4 Std. auf ~40 Min. pro Vorgang',
  },
  {
    az: 'AZ. FR-042',
    quote:
      'Entscheidend war für uns die AVV. Unsere Datenschutzbeauftragte hat vorher jedes KI-Tool blockiert — hier lag der Vertrag vor dem ersten Upload auf dem Tisch.',
    role: 'Qualitätsmanagement (QMB)',
    context: 'MVZ · 6 Standorte · Baden-Württemberg',
    metric: '§203/AVV-Freigabe in 1 Woche',
  },
];

const zahlen = [
  { value: '217', label: 'bearbeitete Prüfanfragen' },
  { value: '2,4 Std.', label: 'Ø Zeitersparnis pro Vorgang' },
  { value: '34', label: 'Häuser & Praxen im Programm' },
  { value: '4,8 / 5', label: 'Ø Bewertung der Entwürfe' },
];
---
{PLACEHOLDER_PROOF && (
  <section id="referenzen" class="py-20 bg-paper-deep border-y-[1.5px] border-line scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="tag tag-file">Aus der Praxis</span>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">
          Wer damit schon Fristen gehalten hat
        </h2>
        <p class="mt-3 text-lg text-ink-soft">
          Pflegedienste, MVZ und Praxen, die dieselbe Prüfanfrage auf dem Tisch hatten.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line border-[1.5px] border-line">
        {stimmen.map(s => (
          <figure class="bg-paper p-7 flex flex-col">
            <span class="font-mono text-xs text-stamp font-semibold tracking-wider">{s.az}</span>
            <blockquote class="mt-4 text-ink leading-relaxed grow">
              <p>„{s.quote}“</p>
            </blockquote>
            <figcaption class="mt-6 pt-5 border-t border-line">
              <div class="font-display text-sm font-bold text-ink">{s.role}</div>
              <div class="mt-0.5 font-mono text-[11px] text-ink-faint">{s.context}</div>
              <div class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-file">
                <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {s.metric}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-px grid grid-cols-2 lg:grid-cols-4 gap-px bg-line border-[1.5px] border-t-0 border-line">
        {zahlen.map(z => (
          <div class="bg-ink text-paper p-6 text-center">
            <div class="font-display text-3xl font-black text-gold-light leading-none">{z.value}</div>
            <div class="mt-2 font-mono text-[10px] uppercase tracking-wider text-paper/60">{z.label}</div>
          </div>
        ))}
      </div>

      <p class="mt-5 font-mono text-[11px] text-ink-faint">
        Stand {new Date().toLocaleDateString('de-DE', { month: 'long', year: 'numeric' })} · Angaben der teilnehmenden Einrichtungen, anonymisiert auf deren Wunsch.
      </p>
    </div>
  </section>
)}
