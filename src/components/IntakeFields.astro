---
/**
 * Block B — the ingestion questions (Q4–Q6 in MARKETING.md).
 *
 * These are the whole reason the funnel exists: how do cases arrive, what
 * system holds the Pflegedokumentation, and can a single Vorgang be exported as
 * PDF. Previously this lived in a standalone BlockBForm that was imported but
 * never rendered, so the questions were never asked of anyone.
 *
 * Now it is a fieldset embedded in the Stufe-1 case form, so Block B is answered
 * as part of the submission that already has the user's attention — one form,
 * one submission, no second drop-off point.
 */
import Field from '@justinguese/astro-kit/Field.astro';
---
<fieldset class="border-[1.5px] border-line p-5 space-y-5">
  <legend class="px-2 font-mono text-xs uppercase tracking-wider text-ink-faint">
    Damit wir Ihre Unterlagen richtig lesen
  </legend>

  <Field name="eingangskanal" label="Wie kommen Prüfanfragen bei Ihnen an?"
         type="select" prompt="Bitte wählen…" required options={[
    { value: 'post', label: 'Post' },
    { value: 'fax', label: 'Fax' },
    { value: 'email', label: 'E-Mail' },
    { value: 'kassenportal', label: 'Kassenportal' },
    { value: 'gemischt', label: 'Gemischt' },
  ]} />

  <Field id="pflegedoku" name="pflegedoku_system" label="In welchem System liegt Ihre Pflegedokumentation?"
         type="select" prompt="Bitte wählen…" required options={[
    { value: 'medifox', label: 'MediFox' },
    { value: 'vivendi', label: 'Vivendi' },
    { value: 'snap', label: 'Snap' },
    { value: 'dan', label: 'DAN' },
    { value: 'papier', label: 'Papier' },
    { value: 'anderes', label: 'Anderes' },
  ]} />

  <Field id="pdf_export" name="pdf_export_moeglich" label="Können Sie daraus einzelne Vorgänge als PDF exportieren?"
         type="select" prompt="Bitte wählen…" required
         hint="„Weiß ich nicht“ ist eine gültige Antwort — wir finden es gemeinsam heraus."
         options={[
    { value: 'ja', label: 'Ja' },
    { value: 'nein', label: 'Nein' },
    { value: 'weiss_nicht', label: 'Weiß ich nicht' },
  ]} />
</fieldset>
