---
/**
 * Nav dropdown for the Ratgeber.
 *
 * Built on <details>/<summary> on purpose: it opens, closes and takes keyboard
 * focus without a line of JavaScript, so it still works if the script below
 * never runs. The script only adds the two behaviours the element does not give
 * us for free — closing on outside click and on Escape.
 */
import { artikelNachKategorie } from '../lib/ratgeber';

const gruppen = (await artikelNachKategorie()).filter(g => g.artikel.length > 0);
---
<details id="ratgeber-menu" class="group relative">
  <summary
    class="flex items-center gap-1.5 cursor-pointer list-none select-none text-sm text-ink-soft hover:text-ink transition-colors"
    aria-haspopup="true"
  >
    Ratgeber
    <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
    </svg>
  </summary>

  <div
    class="fixed inset-x-3 top-[4.25rem] sm:absolute sm:inset-x-auto sm:top-full sm:right-0 sm:mt-3 sm:w-[46rem] max-h-[75vh] overflow-y-auto bg-paper border-[1.5px] border-ink shadow-[6px_6px_0_0_rgba(21,24,27,0.16)] z-50"
  >
    <div class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line">
      {gruppen.map(({ kategorie, artikel }) => (
        <div class="p-5">
          <p class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">
            {kategorie.label}
          </p>
          <ul class="mt-3 space-y-3">
            {artikel.map(a => (
              <li>
                <a
                  href={`/ratgeber/${a.id}`}
                  class="block text-sm font-medium leading-snug text-ink hover:text-stamp transition-colors"
                >
                  {a.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Sticky: on a phone the category lists overflow the 75vh panel, and the
         "alle Beiträge" link is the one thing that must never scroll away. -->
    <div class="sticky bottom-0 border-t-[1.5px] border-line bg-paper-deep px-5 py-4 flex flex-wrap items-center justify-between gap-3">
      <a href="/ratgeber" class="font-mono text-[11px] uppercase tracking-wider text-ink-soft hover:text-ink">
        Alle Beiträge ansehen →
      </a>
      <a
        href="/#starthilfe"
        data-tier-cta="starthilfe"
        class="font-mono text-[11px] uppercase tracking-wider text-stamp hover:underline underline-offset-4"
      >
        Kostenlose Vorlagen
      </a>
    </div>
  </div>
</details>

<script is:inline>
  (() => {
    const menu = document.getElementById('ratgeber-menu');
    if (!menu) return;
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  })();
</script>
