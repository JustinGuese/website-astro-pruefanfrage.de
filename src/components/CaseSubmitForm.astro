---
/**
 * Stufe 1 — case submission.
 *
 * Collects contact details (previously missing entirely, which made every
 * Stufe-1 lead undeliverable: we promise the draft by e-mail and never asked
 * for an address), the Frist so Eilfälle can be pulled forward, the case
 * itself, and Block B's ingestion questions.
 */
import FormBlock from '@justinguese/astro-kit/FormBlock.astro';
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import Field from '@justinguese/astro-kit/Field.astro';
import IntakeFields from './IntakeFields.astro';
import { site } from '../config/site';
---
<FormBlock
  formspreeId={site.formspreeId!}
  variant="stufe1"
  name="fall_einreichen"
  success={{ flag: 'fall_eingereicht', anchor: 'fall-eingereicht' }}
  submitLabel="Fall kostenlos einreichen"
  class="bg-canvas border-[1.5px] border-ink/80 p-6 sm:p-8 space-y-5"
>
  <div class="grid sm:grid-cols-2 gap-5">
    <Field id="fall-name" name="name" label="Ansprechpartner:in" required
           autocomplete="name" placeholder="Ihr Name" />
    <Field id="fall-firma" name="firma" label="Firma / Einrichtung" required
           autocomplete="organization" placeholder="Ambulanter Pflegedienst Muster GmbH" />
  </div>

  <Field id="fall-email" name="email" label="Geschäftliche E-Mail" type="email" required
         autocomplete="email" placeholder="sie@ihr-pflegedienst.de"
         hint="An diese Adresse senden wir den fertigen Entwurf." />

  <div class="grid sm:grid-cols-2 gap-5">
    <Field name="art_der_pruefung" label="Art der Prüfanfrage" type="select" prompt="Bitte wählen…" required options={[
      { value: 'pflegegrad_pruefung', label: 'Pflegegrad-Prüfung' },
      { value: 'sgb5_abrechnungspruefung', label: '§275 SGB V Abrechnungsprüfung' },
      { value: 'stellungnahme_mit_frist', label: 'Stellungnahme mit Frist' },
      { value: 'sonstige', label: 'Sonstige' },
    ]} />
    <Field name="frist" label="Fristende laut Schreiben" type="date"
           hint="Eilfälle ziehen wir vor." />
  </div>

  <Field name="fall_kennung" label="Interne Fall-Kennung (optional)"
         placeholder="z.B. PG-001, §275-042"
         hint="Nicht der echte Patientenname — nur für Ihre interne Referenzierung." />

  <IntakeFields />

  <div class="border-[1.5px] border-line bg-canvas-deep p-4">
    <p class="font-mono text-xs uppercase tracking-wider text-ink-faint mb-1.5">Geschwärzte Dokumente</p>
    <p class="text-sm text-ink-soft leading-relaxed">Bitte noch nicht hochladen — nach dem Absenden erhalten Sie eine E-Mail; antworten Sie darauf mit den geschwärzten Dokumenten (PDF, JPG, PNG) im Anhang.</p>
  </div>

  <div class="flex items-start gap-3">
    <input
      id="anonymity_check" name="anonymity_confirmed" type="checkbox" required
      class="mt-1 h-5 w-5 border-[1.5px] border-line bg-canvas cursor-pointer focus:outline-none focus:border-ink"
    />
    <label for="anonymity_check" class="text-sm text-ink-soft leading-relaxed cursor-pointer">
      Ich bestätige, dass ich ausschließlich vollständig anonymisierte/pseudonymisierte Dokumente ohne direkte Patientenidentifikatoren (Namen, Geburtsdatum, Adresse, Versichertennummer) einreichen werde.
    </label>
  </div>

  <ArrowRight slot="submit-icon" />

  <p slot="note" class="font-mono text-xs text-ink-faint text-center leading-relaxed">
    Ihre ersten 3 Fälle sind kostenlos — keine Karte, kein Abo. Den Entwurf erhalten Sie in der Regel innerhalb von <strong>5 Werktagen</strong> per E-Mail. Mit dem Absenden stimmen Sie unserer <a href={site.privacyHref} class="underline hover:text-ink">Datenschutzerklärung</a> zu.
  </p>
</FormBlock>
