---
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import { site } from '../config/site';
import { formspreeAction } from '@justinguese/astro-kit/lib/site';
/**
 * Order form for the paid rungs (Notfallkit €19, Human-Check-Paket €390).
 *
 * No payment provider yet — this collects the order over Formspree and you
 * invoice by hand. The `tier` hidden field (via TrackingFields) is what makes a
 * submission attributable to the box it came from, so keep it distinct per rung.
 */
import TrackingFields from '@justinguese/astro-kit/TrackingFields.astro';
import Field from '@justinguese/astro-kit/Field.astro';

interface Props {
  tier: 'notfallkit' | 'stufe2';
  /** Query flag the success banner on the page listens for. */
  successFlag: string;
  /** Anchor to scroll to after the Formspree redirect. */
  successAnchor: string;
  submitLabel: string;
  /** Fine print under the button. */
  note: string;
  /** Green button for the Stufe-2 box, accent red elsewhere. */
  accent?: 'accent' | 'support';
}

const { tier, successFlag, successAnchor, submitLabel, note, accent = 'accent' } = Astro.props;
const landingPage = Astro.url.pathname;

const buttonClass =
  accent === 'support'
    ? 'text-canvas bg-support hover:bg-support-bright'
    : 'text-canvas bg-accent hover:bg-[color-mix(in_srgb,var(--color-accent)_88%,black)]';
---
<form
  action={formspreeAction(site.formspreeId!)}
  method="POST"
  class="space-y-4"
>
  <input type="hidden" name="form" value="bestellung" />
  <input type="hidden" name="_next" value={`${landingPage}?${successFlag}=1#${successAnchor}`} />
  <TrackingFields variant={tier} />

  <Field id={`${tier}-firma`} name="firma" label="Firma / Einrichtung" required
         autocomplete="organization" placeholder="Ambulanter Pflegedienst Muster GmbH" />

  <Field id={`${tier}-email`} name="email" label="Geschäftliche E-Mail" type="email" required
         autocomplete="email" placeholder="sie@ihr-pflegedienst.de"
         hint="An diese Adresse gehen Rechnung und Lieferung." />

  <button
    type="submit"
    data-cta={tier}
    class={`w-full inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold transition-all shadow-[4px_4px_0_0_var(--color-ink)] hover:shadow-[2px_2px_0_0_var(--color-ink)] hover:translate-x-[2px] hover:translate-y-[2px] ${buttonClass}`}
  >
    {submitLabel}
    <ArrowRight class="h-4 w-4" />
  </button>

  <p class="font-mono text-xs text-ink-faint text-center leading-relaxed">
    {note} Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
  </p>
</form>
