---
/**
 * End-of-article conversion block.
 *
 * Article traffic is colder than ad traffic, so this asks for two fields, not
 * the four of Block A on the homepage — a reader who has just spent eight
 * minutes on a Ratgeber page will trade an e-mail for the templates, but not a
 * questionnaire. The `landing_page` hidden field in TrackingFields records
 * which article produced the lead, so we still learn which topic converts.
 *
 * Below the form the full ladder is repeated as plain links, so a reader who is
 * further along can skip the free tier and go straight to the paid rungs.
 */
import TrackingFields from './TrackingFields.astro';

interface Props {
  /** Path of the article this block sits on — used for the Formspree redirect. */
  pfad: string;
}

const { pfad } = Astro.props;
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_BLOCK_A_ID || 'REPLACE_WITH_FORMSPREE_ID';

const leiter = [
  {
    href: '/#notfallkit',
    tier: 'notfallkit',
    preis: '€19',
    titel: 'Fristen-Notfallkit',
    text: 'Antwortvorlagen und Eskalations-Checkliste, wenn die Frist zu knapp für den regulären Weg ist.',
  },
  {
    href: '/#fall-hochladen',
    tier: 'stufe1',
    preis: '3 Fälle gratis',
    titel: 'KI-Prüfvorbereitung',
    text: 'Geschwärzte Prüfanfrage hochladen, in rund 5 Werktagen einen quellenbelegten Antwortentwurf zurück. Danach €49 pro Fall.',
  },
  {
    href: '/#preise',
    tier: 'allgemein',
    preis: 'Übersicht',
    titel: 'Alle Stufen im Vergleich',
    text: 'Vom kostenlosen Muster bis zum Workflow-Audit — was in welcher Stufe enthalten ist.',
  },
];
---
<aside class="mt-16 not-prose" aria-labelledby="artikel-cta-titel">
  <!-- Success banner, revealed by the Formspree redirect on this same article. -->
  <div
    id="starthilfe-download"
    class="hidden mb-6 border-[1.5px] border-file bg-paper-deep p-6 scroll-mt-24"
  >
    <h3 class="font-display text-xl font-bold text-ink">Unterlagen freigeschaltet.</h3>
    <p class="mt-2 text-ink-soft leading-relaxed">
      Die Muster liegen als PDF bereit — Sie können sie direkt an Ihre Datenschutzbeauftragte weitergeben.
    </p>
    <ul class="mt-4 space-y-2">
      <li><a href="/downloads/203-mustervereinbarung.pdf" class="font-semibold text-stamp underline underline-offset-4" download>§203-Mustervereinbarung (PDF)</a></li>
      <li><a href="/downloads/muster-avv.pdf" class="font-semibold text-stamp underline underline-offset-4" download>Muster-AVV nach Art. 28 DSGVO (PDF)</a></li>
      <li><a href="/downloads/mdr-abgrenzungsnotiz.pdf" class="font-semibold text-stamp underline underline-offset-4" download>MDR-Abgrenzungsnotiz (PDF)</a></li>
    </ul>
  </div>

  <div class="bg-ink text-paper border-[1.5px] border-ink">
    <div class="p-7 sm:p-10 grid lg:grid-cols-2 gap-8 lg:gap-12">
      <div>
        <span class="tag tag-gold">Kostenlose Starthilfe</span>
        <h2 id="artikel-cta-titel" class="mt-4 font-display text-2xl sm:text-3xl font-black tracking-tight text-paper leading-tight">
          Die Vorlagen, die in diesem Artikel vorausgesetzt werden — kostenlos.
        </h2>
        <p class="mt-3 text-paper/70 leading-relaxed">
          §203-Mustervereinbarung, Muster-AVV nach Art. 28 DSGVO und die einseitige
          MDR-Abgrenzungsnotiz als PDF. Ungezeichnete Entwürfe zum Prüfen, kein Abo,
          keine Kreditkarte.
        </p>

        <form
          action={`https://formspree.io/f/${formspreeId}`}
          method="POST"
          class="mt-6 space-y-3"
        >
          <input type="hidden" name="form" value="ratgeber_starthilfe" />
          <input type="hidden" name="_next" value={`${pfad}?starthilfe=1#starthilfe-download`} />
          <TrackingFields tier="starthilfe" />

          <!-- Stacked, not side by side: this block sits in a half-width column,
               where two inputs on one row truncate their own placeholders. -->
          <div class="grid gap-3">
            <div>
              <label for="cta-firma" class="sr-only">Firma</label>
              <input
                id="cta-firma" name="firma" type="text" required autocomplete="organization"
                placeholder="Ihr Pflegedienst / Ihre Praxis"
                class="w-full border-[1.5px] border-paper/25 bg-transparent px-4 py-3 text-base text-paper placeholder-paper/40 focus:outline-none focus:border-gold-light"
              />
            </div>
            <div>
              <label for="cta-email" class="sr-only">Geschäftliche E-Mail</label>
              <input
                id="cta-email" name="email" type="email" required autocomplete="email"
                placeholder="sie@ihr-pflegedienst.de"
                class="w-full border-[1.5px] border-paper/25 bg-transparent px-4 py-3 text-base text-paper placeholder-paper/40 focus:outline-none focus:border-gold-light"
              />
            </div>
          </div>

          <button
            type="submit"
            data-tier-cta="starthilfe"
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold text-paper bg-stamp hover:bg-[color-mix(in_srgb,var(--color-stamp)_88%,black)] transition-colors"
          >
            Vorlagen kostenlos anfordern
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
          </button>

          <p class="font-mono text-[11px] text-paper/50 text-center">
            Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-paper">Datenschutzerklärung</a> zu.
          </p>
        </form>
      </div>

      <div class="lg:border-l lg:border-paper/15 lg:pl-12">
        <p class="font-mono text-[11px] uppercase tracking-widest text-paper/45">
          Wenn die Frist schon läuft
        </p>
        <div class="mt-4 divide-y divide-paper/12 border-y border-paper/12">
          {leiter.map(stufe => (
            <a
              href={stufe.href}
              data-tier-cta={stufe.tier}
              class="group flex items-start gap-4 py-4 hover:bg-paper/5 transition-colors"
            >
              <span class="min-w-0 grow">
                <span class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-gold-light">
                  {stufe.preis}
                </span>
                <span class="mt-1.5 block font-display font-bold text-paper group-hover:text-gold-light transition-colors">
                  {stufe.titel}
                </span>
                <span class="mt-1 block text-sm text-paper/60 leading-relaxed">{stufe.text}</span>
              </span>
              <svg class="h-4 w-4 shrink-0 mt-1 text-paper/35 group-hover:text-gold-light transition-all group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          ))}
        </div>
        <p class="mt-5 font-mono text-[11px] text-paper/45 leading-relaxed">
          Unbrauchbarer Entwurf, keine Rechnung. Formlos innerhalb von 14 Tagen,
          ohne Begründung.
        </p>
      </div>
    </div>
  </div>
</aside>
