---
/**
 * Block A — the free-tier e-mail gate in front of the Starthilfe templates.
 * Q1–Q3 from MARKETING.md: who they are, volume, and who answers today.
 */
import TrackingFields from '@justinguese/astro-kit/TrackingFields.astro';
import { formspreeAction } from '@justinguese/astro-kit/lib/site';
import { site } from '../config/site';
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import Field from '@justinguese/astro-kit/Field.astro';

const landingPage = Astro.url.pathname;
---
<form
  action={formspreeAction(site.formspreeId!)}
  method="POST"
  class="bg-canvas border-[1.5px] border-ink/80 p-6 sm:p-8 space-y-5"
>
  <input type="hidden" name="form" value="block_a" />
  <input type="hidden" name="_next" value={`${landingPage}?starthilfe=1#starthilfe-download`} />
  <TrackingFields variant="starthilfe" />

  <div class="grid sm:grid-cols-2 gap-5">
    <Field name="firma" label="Firma" required autocomplete="organization"
           placeholder="Ambulanter Pflegedienst Muster GmbH" />
    <Field name="email" label="Geschäftliche E-Mail" type="email" required autocomplete="email"
           placeholder="sie@ihr-pflegedienst.de" />
  </div>

  <Field name="einrichtungsart" label="Einrichtungsart" type="select" prompt="Bitte wählen…" required options={[
    { value: 'ambulanter_pflegedienst', label: 'Ambulanter Pflegedienst' },
    { value: 'stationaere_pflege', label: 'Stationäre Pflege' },
    { value: 'mvz', label: 'MVZ' },
    { value: 'arztpraxis', label: 'Arztpraxis' },
    { value: 'sonstige', label: 'Sonstige' },
  ]} />

  <Field id="pruefanfragen" name="pruefanfragen_pro_monat" label="Prüfanfragen pro Monat"
         type="select" prompt="Bitte wählen…" required options={[
    { value: '0-5', label: '0–5' },
    { value: '6-20', label: '6–20' },
    { value: 'ueber-20', label: 'Über 20' },
  ]} />

  <Field id="beantwortet" name="wer_beantwortet_heute" label="Wer beantwortet sie heute?"
         type="select" prompt="Bitte wählen…" required options={[
    { value: 'gf', label: 'Geschäftsführung' },
    { value: 'pdl', label: 'Pflegedienstleitung (PDL)' },
    { value: 'qmb', label: 'Qualitätsmanagement (QMB)' },
    { value: 'extern', label: 'Externe Beratung' },
  ]} />

  <button type="submit" data-cta="starthilfe" class="btn-primary w-full">
    Vorlagen kostenlos anfordern
    <ArrowRight />
  </button>

  <p class="font-mono text-xs text-ink-faint text-center">
    Kostenlos, kein Abo. Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
  </p>
</form>
