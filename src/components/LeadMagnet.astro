---
/**
 * Stufe 0.5 — the €19 impulse rung.
 *
 * Closes the gap between the free templates (€0) and the first real case
 * (€49/Fall, and only after three free ones). No data upload, no conversation —
 * and it qualifies a lead by wallet rather than by form-filling.
 *
 * Ordered over Formspree and invoiced by hand for now; `tier=notfallkit` on the
 * submission is what makes it separable from the other boxes.
 */
import OrderForm from './OrderForm.astro';

const inhalt = [
  '6 Antwortvorlagen: Pflegegrad-Widerspruch, §275-Stellungnahme, Fristverlängerung, Akteneinsicht',
  'Fristen-Übersicht: welche Frist bei welcher Anfrageart läuft — und ab wann sie zählt',
  'Eskalations-Checkliste für den Fall, dass die Kasse nicht reagiert',
  'Formulierungsbausteine, die auf Ihre Pflegedokumentation verweisen statt zu behaupten',
];
---
<section id="notfallkit" class="py-16 sm:py-20 bg-canvas scroll-mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div id="notfallkit-bestellt" class="hidden mb-8 bg-support text-canvas p-6 sm:p-8 border-[1.5px] border-support">
      <h3 class="font-display text-xl font-bold">Bestellung angekommen.</h3>
      <p class="mt-2">Sie erhalten Rechnung und Download-Link in der Regel am selben Werktag per E-Mail.</p>
    </div>

    <div class="border-[1.5px] border-ink/80 bg-canvas-deep grid lg:grid-cols-12">
      <div class="lg:col-span-7 p-7 sm:p-9">
        <span class="tag tag-accent">Sofort-Download</span>

        <h2 class="mt-4 font-display text-2xl sm:text-3xl font-black tracking-tight text-ink leading-tight">
          Fristen-Notfallkit
        </h2>
        <p class="mt-3 text-ink-soft leading-relaxed">
          Die Frist läuft heute ab und Sie wollen nichts hochladen? Dann schreiben Sie die Antwort selbst —
          aber nicht von null. Alles, was wir in unseren Entwürfen verwenden, als bearbeitbare Vorlage.
        </p>

        <ul class="mt-6 space-y-3">
          {inhalt.map(i => (
            <li class="flex items-start gap-3 text-sm text-ink-soft leading-relaxed">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-accent"></span>
              {i}
            </li>
          ))}
        </ul>

        <p class="mt-6 text-sm text-ink">
          <strong>Anrechenbar:</strong> Der Kaufpreis wird auf Ihren ersten kostenpflichtigen Fall angerechnet.
        </p>
      </div>

      <div class="lg:col-span-5 bg-canvas border-t-[1.5px] lg:border-t-0 lg:border-l-[1.5px] border-ink/80 p-7 sm:p-9 flex flex-col justify-center">
        <span class="font-mono text-xs uppercase tracking-widest text-ink-faint">Einmalig</span>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="font-display text-5xl font-black text-ink">€19</span>
          <span class="text-sm text-ink-faint">zzgl. USt.</span>
        </div>
        <p class="mt-2 mb-5 text-sm text-ink-soft">Lieferung per E-Mail, in der Regel am selben Werktag. Kein Abo.</p>

        <OrderForm
          tier="notfallkit"
          successFlag="notfallkit_bestellt"
          successAnchor="notfallkit"
          submitLabel="Notfallkit für €19 bestellen"
          note="Rechnung und Download-Link kommen per E-Mail."
        />
      </div>
    </div>
  </div>
</section>
