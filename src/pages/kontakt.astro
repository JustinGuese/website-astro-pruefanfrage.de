---
import { site } from '../config/site';
import { formspreeAction } from '@justinguese/astro-kit/lib/site';
import Site from '../layouts/Site.astro';
import TrackingFields from '@justinguese/astro-kit/TrackingFields.astro';
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import Field from '@justinguese/astro-kit/Field.astro';

const landingPage = Astro.url.pathname;

const title = `Kontakt | ${site.name}`;
const description = 'Kontaktieren Sie pruefanfrage.de für Stufe 2, Stufe 3 oder ein Pilotprojekt.';
---
<Site title={title} description={description}>
  <section class="bg-canvas-deep border-b-[1.5px] border-line">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12 text-center">
      <span class="tag tag-az">Kontakt</span>
      <h1 class="mt-5 font-display text-4xl sm:text-5xl font-black tracking-tight text-ink leading-tight">Lassen Sie uns reden.</h1>
      <p id="pre-header" class="mt-4 text-lg text-ink-soft max-w-2xl mx-auto">Fragen zu Stufe 2, Stufe 3 oder einem Pilotprojekt? Schreiben Sie uns — wir antworten in der Regel innerhalb eines Werktages.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="sent-banner" class="hidden mb-6 p-4 border-[1.5px] border-support bg-canvas text-ink text-sm">
        <span class="tag tag-support mb-2">Angekommen</span>
        <p class="mt-2">Danke! Ihre Nachricht ist angekommen — wir melden uns in Kürze.</p>
      </div>

      <form
        id="kontakt-form"
        action={formspreeAction(site.formspreeId!)}
        method="POST"
        class="bg-canvas border-[1.5px] border-ink/80 p-6 sm:p-8 space-y-5"
      >
        <input type="hidden" name="form" value="kontakt" />
        <input type="hidden" id="interesse-field" name="interesse" value="allgemein" />
        <input type="hidden" id="next-field" name="_next" value={`${landingPage}?sent=1`} />
        <TrackingFields variant="allgemein" />

        <div class="grid sm:grid-cols-2 gap-5">
          <Field name="name" label="Name" required autocomplete="name" placeholder="Ihr Name" />
          <Field name="firma" label="Firma" required autocomplete="organization"
                 placeholder="Ihr Pflegedienst / MVZ / Praxis" />
        </div>

        <Field name="email" label="E-Mail" type="email" required autocomplete="email"
               placeholder="sie@firma.de" />

        <div class="grid sm:grid-cols-2 gap-5">
          <Field id="hrb" name="hrb_nummer" label="HRB-Nummer" note="(für die Rechnungsstellung)"
                 placeholder="HRB …" />
          <Field name="geschaeftsfuehrung" label="Geschäftsführung" note="(optional)"
                 placeholder="Name der Geschäftsführung" />
        </div>

        <Field name="phone" label="Telefon" note="(optional)" type="tel" autocomplete="tel"
               placeholder="+49 …" />

        <Field name="message" label="Nachricht" type="textarea" required rows={6}
               placeholder="Worum geht es?" />

        <button type="submit" class="btn-primary w-full">
          Nachricht senden
          <ArrowRight />
        </button>

        <p class="font-mono text-xs text-ink-faint text-center">
          Mit dem Absenden stimmen Sie unserer <a href="/datenschutz" class="underline hover:text-ink">Datenschutzerklärung</a> zu.
        </p>
      </form>
    </div>
  </section>

  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const interesse = params.get('interesse');

      const copy = {
        notfallkit: 'Sie interessieren sich für das Fristen-Notfallkit (€19) — senden Sie uns kurz Ihre Kontaktdaten, wir schicken Ihnen Rechnung und Download-Link.',
        stufe2: 'Sie interessieren sich für das Human-Check-Paket (€390, 5 Fälle) — senden Sie uns kurz Ihre Kontaktdaten, wir schicken Ihnen die Rechnung und die Details zum Ablauf.',
        stufe3: 'Sie interessieren sich für den Compliance- & Workflow-Check (€1.900) — senden Sie uns kurz Ihre Kontaktdaten, wir vereinbaren einen Termin.',
        pilot: 'Sie interessieren sich für ein Pilotprojekt (€8.000–15.000) — senden Sie uns kurz Ihre Kontaktdaten, wir melden uns für ein Erstgespräch.',
      };

      if (interesse && copy[interesse]) {
        const preHeader = document.getElementById('pre-header');
        if (preHeader) preHeader.textContent = copy[interesse];
        const interesseField = document.getElementById('interesse-field');
        if (interesseField) interesseField.value = interesse;
        // Keep `tier` in step so submissions stay separable by offer box.
        const tierField = document.querySelector('#kontakt-form input[name="tier"]');
        if (tierField) tierField.value = interesse;
        const nextField = document.getElementById('next-field');
        if (nextField) nextField.value = nextField.value + `&interesse=${interesse}`;
      }

      if (params.get('sent') === '1') {
        document.getElementById('sent-banner')?.classList.remove('hidden');
        document.getElementById('kontakt-form')?.classList.add('hidden');
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'Lead', {
            content_name: 'Contact Form Submission',
            content_category: 'Contact'
          });
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'generate_lead', {
            form_name: 'kontakt',
            content_category: 'Contact'
          });
        }
        params.delete('sent');
        const qs = params.toString();
        const newUrl = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        window.history.replaceState({}, '', newUrl);
      }
    })();
  </script>
</Site>
