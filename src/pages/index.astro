---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BlockAForm from '../components/BlockAForm.astro';
import BestellForm from '../components/BestellForm.astro';
import FallEinreichenForm from '../components/FallEinreichenForm.astro';
import SocialProof from '../components/SocialProof.astro';
import PricingMatrix from '../components/PricingMatrix.astro';
import Notfallkit from '../components/Notfallkit.astro';
import Kapazitaet from '../components/Kapazitaet.astro';
import FristRechner from '../components/FristRechner.astro';
import Faq from '../components/Faq.astro';
import { alleArtikel, kategorieOf } from '../lib/ratgeber';

// Six most recent Ratgeber articles. The homepage is the strongest page on the
// domain, so it links out to the SEO surface directly rather than only through
// the nav dropdown.
const ratgeberTeaser = (await alleArtikel()).slice(0, 6);

// Pain first, and priced. "Verlorene Zeit" does not move a Geschäftsführung;
// a number with a € in front of it does.
const szenarien = [
  {
    az: 'AZ. PG-01',
    title: 'Pflegegrad-Prüfung mit kurzer Frist',
    body: 'Der MD fordert eine Stellungnahme innerhalb weniger Tage. Verstreicht die Frist, gilt oft die Einstufung der Kasse — eine Herabstufung mit direkten Einbußen bei der Vergütung.',
    kosten: 'Herabstufung PG 4 → PG 3: rund €280 weniger pro Monat und Klient',
  },
  {
    az: 'AZ. §275-02',
    title: '§275 SGB V Abrechnungsprüfung',
    body: 'Die Kasse zweifelt abgerechnete Leistungen an. Ohne belegte Antwort drohen Rückforderungen bereits ausgezahlter Vergütung — rückwirkend, oft über mehrere Monate.',
    kosten: 'Rückforderung über 6 Monate: schnell vierstellig, pro Fall',
  },
  {
    az: 'AZ. FR-03',
    title: 'Stellungnahmen mit Frist',
    body: 'Formlose Anfragen, MDK-Gutachten, Widersprüche — wer die Frist verstreichen lässt, verliert meist das Widerspruchsrecht. Die Entscheidung der Kasse steht dann endgültig fest.',
    kosten: 'Widerspruchsrecht verloren: der Bescheid ist bestandskräftig',
  },
];

const wasEsNichtIst = [
  {
    mark: 'KEIN',
    rest: 'automatisierter Verwaltungsakt',
    body: 'Jede Antwort geht erst nach Ihrer Freigabe raus — nie automatisiert an Kasse oder MD.',
  },
  {
    mark: 'KEIN',
    rest: '§203-Bruch',
    body: 'Unterlagen werden nur im Rahmen einer unterschriebenen AVV verarbeitet — niemals in ein offenes KI-Tool kopiert.',
  },
  {
    mark: 'KEINE',
    rest: 'Rechtsberatung',
    body: 'Wir unterstützen bei der organisatorischen Aufbereitung. Die rechtliche Bewertung bleibt bei Ihnen oder Ihrer Rechtsberatung.',
  },
];
---
<Site>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "pruefanfrage.de",
    "url": "https://pruefanfrage.de",
    "parentOrganization": {
      "@type": "Organization",
      "name": "DataFortress.cloud GmbH"
    },
    "description": "KI-gestützte, §203-konforme Unterstützung bei Pflegegrad-Prüfungen, §275 SGB V Abrechnungsprüfungen und Prüfanfragen für Pflegedienste, MVZ und Arztpraxen."
  })} />

  <!-- 1 — DER SCHMERZ. Headline benennt die Situation, nicht das Produkt. -->
  <Hero
    title="Prüfanfrage mit Frist auf dem Tisch?"
    subtitle="Verpasste Fristen kosten nicht Zeit, sondern Geld — Rückforderungen und Herabstufungen. Sie laden den geschwärzten Fall hoch (rund 10 Minuten), wir liefern den quellenbelegten Antwortentwurf. Die ersten 3 Fälle sind kostenlos."
    ctaText="Erste 3 Fälle kostenlos einreichen"
    ctaHref="#fall-hochladen"
    stats={[
      { value: '3', label: 'Fälle kostenlos' },
      { value: '5 Tage', label: 'bis zum Entwurf' },
      { value: '0', label: 'Verträge nötig' }
    ]}
  >
    <Kapazitaet slot="urgency" variant="badge" />
    <p slot="cta-secondary" class="mt-4 text-sm text-ink-soft">
      <span>Frist läuft in wenigen Tagen? </span>
      <a href="#frist-rechner" class="font-semibold text-stamp underline underline-offset-2 hover:text-stamp-bright">Prüfen, ob die Zeit reicht →</a>
    </p>
  </Hero>

  <!-- 1b — Der Schmerz, konkret und beziffert. -->
  <section id="szenarien" class="py-20 bg-paper-deep border-y-[1.5px] border-line scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <span class="tag tag-stamp">Das Problem</span>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">Drei Situationen, die jede Woche passieren</h2>
        <p class="mt-3 text-lg text-ink-soft">Nicht nur Zeit steht auf dem Spiel. Jede verpasste Frist hat eine finanzielle Konsequenz.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-line border-[1.5px] border-line">
        {szenarien.map(s => (
          <div class="bg-paper p-7 flex flex-col">
            <span class="font-mono text-xs text-stamp font-semibold tracking-wider">{s.az}</span>
            <h3 class="mt-3 font-display text-lg font-bold text-ink leading-snug">{s.title}</h3>
            <p class="mt-2.5 text-sm text-ink-soft leading-relaxed grow">{s.body}</p>
            <p class="mt-5 pt-4 border-t border-line font-mono text-xs text-stamp font-semibold leading-relaxed">
              {s.kosten}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 — WIE WIR DAS LÖSEN. -->
  <section id="so-funktioniert-es" class="py-20 bg-paper scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <span class="tag tag-az">Die Lösung</span>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">So funktioniert es — von Eingang zu Absender</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
        <div>
          <span class="font-mono text-3xl font-bold text-stamp">01</span>
          <h3 class="mt-3 font-display text-lg font-bold text-ink">Fall hochladen</h3>
          <p class="mt-2 text-ink-soft leading-relaxed">Sie senden die geschwärzte Prüfanfrage über unser sicheres Formular — rund 10 Minuten Aufwand auf Ihrer Seite.</p>
        </div>
        <div>
          <span class="font-mono text-3xl font-bold text-stamp">02</span>
          <h3 class="mt-3 font-display text-lg font-bold text-ink">KI-gestützter Entwurf</h3>
          <p class="mt-2 text-ink-soft leading-relaxed">Wir erstellen einen Antwortentwurf mit Quellenverweisen aus Ihrer Pflegedokumentation. In der Regel innerhalb von 5 Werktagen bei Ihnen.</p>
        </div>
        <div>
          <span class="font-mono text-3xl font-bold text-stamp">03</span>
          <h3 class="mt-3 font-display text-lg font-bold text-ink">Prüfung & Versand</h3>
          <p class="mt-2 text-ink-soft leading-relaxed">Sie prüfen und versenden — statt 2–4 Stunden Eigenrecherche bleiben rund 30–45 Minuten Durchsicht. Sie bleiben der Absender.</p>
        </div>
      </div>

      <div class="max-w-3xl border-[1.5px] border-ink/80 bg-paper-deep p-6 sm:p-8 flex gap-4">
        <svg class="h-6 w-6 text-stamp shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <p class="text-sm text-ink-soft leading-relaxed">
          <strong class="text-ink">Art. 26 AI Act & §630a BGB:</strong> Der Entwurf ist Organisationshilfe, keine automatisierte Entscheidung. Die Dokumentationspflicht nach §630a BGB und die Transparenzpflichten nach Art. 26 AI Act bleiben bei Ihnen — wir unterstützen, wir entscheiden nicht.
        </p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-paper-deep border-y-[1.5px] border-line">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">Manuell. Rohes ChatGPT. Oder richtig.</h2>
      </div>
      <ComparisonTable />
    </div>
  </section>

  <!-- 3 — SOCIAL PROOF. Vor dem ersten Preis, nach der Lösung. -->
  <SocialProof />

  <!-- 4 — DIE ANGEBOTE, aufsteigend. Zuerst: kostenlos, ohne Dateneingabe. -->
  <section id="starthilfe" class="py-16 sm:py-20 bg-paper scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div>
          <span class="tag tag-az">Kostenlos · keine Dateneingabe nötig</span>
          <h2 class="mt-4 font-display text-2xl sm:text-3xl font-black tracking-tight text-ink">Kostenlose Starthilfe</h2>
          <p class="mt-3 text-lg text-ink-soft">
            Noch nicht bereit für den Live-Fall? Holen Sie sich die Muster für §203-Vereinbarung und
            Auftragsverarbeitung — als PDF, sofort einsatzbereit für die Vorlage bei Ihrer
            Datenschutzbeauftragten.
          </p>
          <div class="mt-6">
            <BlockAForm />
          </div>
        </div>

        <div id="frist-rechner" class="scroll-mt-20 space-y-6">
          <FristRechner />
          <div class="border-[1.5px] border-line bg-paper-deep p-6">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">Enthalten in der Starthilfe</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-soft">
              <li class="flex items-start gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-stamp"></span>§203-Mustervereinbarung (PDF)</li>
              <li class="flex items-start gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-stamp"></span>Muster-AVV nach Art. 28 DSGVO (PDF)</li>
              <li class="flex items-start gap-2.5"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-stamp"></span>MDR-Abgrenzungsnotiz (PDF)</li>
            </ul>
          </div>
        </div>
      </div>

      <div id="starthilfe-download" class="hidden mt-10 max-w-2xl scroll-mt-20">
        <div class="bg-paper-deep border-[1.5px] border-file p-6 sm:p-8">
          <span class="tag tag-file">Akte freigegeben</span>
          <h3 class="mt-3 font-display text-xl font-bold text-ink">Ihre Starthilfe-Akte ist bereit.</h3>
          <p class="mt-1 text-sm text-ink-soft">Entwürfe zur Prüfung durch Ihre Geschäftsführung / Datenschutzbeauftragte — siehe Hinweis in jedem Dokument.</p>
          <ul class="mt-5 space-y-3">
            <li>
              <a href="/downloads/203-mustervereinbarung.pdf" download class="flex items-center gap-3 text-ink font-semibold hover:text-stamp">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                §203-Mustervereinbarung (PDF)
              </a>
            </li>
            <li>
              <a href="/downloads/muster-avv.pdf" download class="flex items-center gap-3 text-ink font-semibold hover:text-stamp">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                Muster-AVV nach Art. 28 DSGVO (PDF)
              </a>
            </li>
            <li>
              <a href="/downloads/mdr-abgrenzungsnotiz.pdf" download class="flex items-center gap-3 text-ink font-semibold hover:text-stamp">
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
                MDR-Abgrenzungsnotiz (PDF)
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4b — €19: die Stufe zwischen "gratis" und "echter Fall". -->
  <Notfallkit />

  <!-- 4c — STUFE 1, die Kernleistung. -->
  <section id="ki-pruefvorbereitung" class="py-16 sm:py-20 bg-paper-deep border-y-[1.5px] border-line scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12">
        <span class="tag tag-stamp">Die Kernleistung</span>
        <h2 class="mt-4 font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">KI-Prüfvorbereitung</h2>
        <p class="mt-3 text-lg text-ink-soft">Laden Sie einen anonymisierten Fall hoch — wir bereiten die Antwort vor. Quellenbelegbar, gesetzeskonform, in Ihrer Verantwortung.</p>
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5">
          <div class="p-5 bg-paper border-l-4 border-stamp">
            <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">Konditionen</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-soft">
              <li><strong class="text-ink">Erste 3 Fälle:</strong> kostenlos</li>
              <li><strong class="text-ink">Danach:</strong> €49 zzgl. USt. pro Fall, Rechnung nach Lieferung</li>
              <li><strong class="text-ink">Lieferung:</strong> in der Regel 5 Werktage, Eilfälle vorgezogen</li>
              <li><strong class="text-ink">Bindung:</strong> keine — kein Abo, keine Mindestabnahme</li>
            </ul>
          </div>

          <Kapazitaet variant="band" class="mt-6" />

          <div class="mt-6 bg-paper border-[1.5px] border-ink/80 p-6">
            <span class="font-mono text-xs uppercase tracking-widest text-ink-faint">Beispiel — Ablauf</span>
            <div class="mt-4 space-y-3 text-sm">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 bg-stamp"></span>
                <span class="text-ink">Pflegegrad-Prüfung, MD-Schreiben + Akte</span>
              </div>
              <div class="flex items-center gap-2 text-ink-faint">
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm-4.5-9a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm9 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/></svg>
                <span>KI-Entwurf mit Quellenangaben</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 bg-stamp"></span>
                <span class="text-ink">Ihre Prüfung + Versand an MD</span>
              </div>
            </div>
            <p class="mt-6 font-mono text-[11px] text-ink-faint">AZ. PN-2026-001</p>
          </div>
        </div>

        <div id="fall-hochladen" class="lg:col-span-7 scroll-mt-20">
          <h3 class="font-display text-xl font-bold text-ink mb-4">Laden Sie einen Fall hoch</h3>
          <FallEinreichenForm />
        </div>
      </div>

      <div id="fall-eingereicht" class="hidden mt-10 bg-file text-paper p-6 sm:p-8 text-center border-[1.5px] border-file scroll-mt-20">
        <h3 class="font-display text-xl font-bold">Fall eingereicht.</h3>
        <p class="mt-2">Wir bereiten den Antwortentwurf vor und senden ihn Ihnen in der Regel innerhalb von <strong>5 Werktagen</strong> per E-Mail zu.</p>
        <p class="mt-3 text-sm text-paper/75">Falls Sie Fragen haben, erreichen Sie uns jederzeit über <a href="/kontakt" class="underline font-semibold">Kontakt</a>.</p>
      </div>
    </div>
  </section>

  <!-- 4d — STUFE 2: Human-Check. -->
  <section id="stufe-2" class="py-16 sm:py-20 bg-paper scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="stufe2-bestellt" class="hidden mb-8 bg-file text-paper p-6 sm:p-8 border-[1.5px] border-file">
        <h3 class="font-display text-xl font-bold">Bestellung angekommen.</h3>
        <p class="mt-2">Wir senden Ihnen Rechnung und Ablaufdetails in der Regel innerhalb eines Werktages per E-Mail.</p>
      </div>

      <div class="border-[1.5px] border-file bg-paper-deep grid lg:grid-cols-12">
        <div class="lg:col-span-7 p-7 sm:p-9">
          <span class="tag tag-file">Human-Check · €390</span>
          <h2 class="mt-4 font-display text-2xl sm:text-3xl font-black tracking-tight text-ink">Human-Check-Paket</h2>
          <p class="mt-3 text-ink-soft leading-relaxed">
            <strong class="text-ink">5 Fälle</strong> mit Prüfung durch eine registrierte Pflegefachkraft — ≈ €78 pro Fall,
            6 Monate gültig.
          </p>
          <p class="mt-4 text-ink">
            <strong>Kein unüberwachtes KI-Urteil:</strong> Jeder Entwurf geht zusätzlich durch ein
            Pflegefachkraft-Auge, bevor er bei Ihnen landet. Für die Fälle, bei denen eine Rückforderung
            im Raum steht und Sie nicht allein entscheiden wollen.
          </p>
        </div>

        <div class="lg:col-span-5 bg-paper border-t-[1.5px] lg:border-t-0 lg:border-l-[1.5px] border-file p-7 sm:p-9 flex flex-col justify-center">
          <span class="font-mono text-xs uppercase tracking-widest text-ink-faint">Paketpreis</span>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="font-display text-5xl font-black text-ink">€390</span>
            <span class="text-sm text-ink-faint">zzgl. USt.</span>
          </div>
          <p class="mt-2 mb-5 text-sm text-ink-soft">5 Fälle · ≈ €78 pro Fall · 6 Monate gültig</p>

          <BestellForm
            tier="stufe2"
            successFlag="stufe2_bestellt"
            successAnchor="stufe-2"
            submitLabel="Paket anfragen"
            note="Sie erhalten Rechnung und Ablaufdetails per E-Mail."
            accent="file"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 5 — VERTRAUEN & EINWÄNDE, direkt vor dem Preis. -->
  <section class="py-20 bg-paper-deep border-y-[1.5px] border-line">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14">
        <h2 class="font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">Was es NICHT ist</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10">
        {wasEsNichtIst.map(item => (
          <div>
            <h3 class="font-display text-lg font-bold text-ink leading-snug">
              <span class="mark-redact">{item.mark}</span> {item.rest}
            </h3>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 font-mono text-xs text-ink-faint">
        Details siehe <a href="/rdg-hinweis" class="text-stamp font-semibold hover:underline">RDG-Hinweis</a>.
      </p>
    </div>
  </section>

  <Faq />

  <!-- 5b — RATGEBER. Internal links from the strongest page on the domain. -->
  <section id="ratgeber" class="py-20 bg-paper border-t-[1.5px] border-line scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div class="max-w-2xl">
          <span class="tag tag-az">Ratgeber</span>
          <h2 class="mt-4 font-display text-3xl sm:text-4xl font-black tracking-tight text-ink">
            Erst nachlesen, dann entscheiden
          </h2>
          <p class="mt-3 text-lg text-ink-soft">
            Was der MD prüft, welche Fristen gelten und was Ihre Dokumentation
            tragen muss — ohne Anmeldung lesbar.
          </p>
        </div>
        <a href="/ratgeber" class="shrink-0 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-stamp hover:gap-3 transition-all">
          Alle Beiträge
          <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 border-t-[1.5px] border-l-[1.5px] border-line">
        {ratgeberTeaser.map(a => (
          <a href={`/ratgeber/${a.id}`} class="group bg-paper p-6 border-r-[1.5px] border-b-[1.5px] border-line hover:bg-paper-deep transition-colors flex flex-col">
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">
              {kategorieOf(a.data.category).label} · {a.data.readingTime} Min.
            </span>
            <h3 class="mt-3 font-display text-lg font-bold text-ink leading-snug group-hover:text-stamp transition-colors">
              {a.data.title}
            </h3>
            <p class="mt-2.5 text-sm text-ink-soft leading-relaxed grow">{a.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-paper-deep border-y-[1.5px] border-line">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-display text-2xl sm:text-3xl font-bold text-ink leading-snug">
        „Die Software macht die Arbeit schnell.<br class="hidden sm:block" /> Der Vertrag macht sie erlaubt.“
      </p>
    </div>
  </section>

