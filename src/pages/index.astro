  <script is:inline>
    (() => {
      const params = new URLSearchParams(window.location.search);
      let changed = false;

      // Formspree redirects back with a flag per box, so each success banner is
      // tied to the offer the visitor actually submitted.
      const successStates = [
        { flag: 'starthilfe',        el: 'starthilfe-download', event: 'starthilfe_lead',  label: 'Starthilfe' },
        { flag: 'fall_eingereicht',  el: 'fall-eingereicht',    event: 'fall_eingereicht', label: 'Fall einreichen' },
        { flag: 'notfallkit_bestellt', el: 'notfallkit-bestellt', event: 'notfallkit_bestellt', label: 'Notfallkit' },
        { flag: 'stufe2_bestellt',   el: 'stufe2-bestellt',     event: 'stufe2_bestellt',  label: 'Human-Check-Paket' },
      ];

      successStates.forEach(({ flag, el, event, label }) => {
        if (params.get(flag) !== '1') return;
        document.getElementById(el)?.classList.remove('hidden');
        if (typeof window.gtag === 'function') {
          window.gtag('event', event, { content_category: 'Funnel' });
        }
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'Lead', { content_name: label });
        }
        params.delete(flag);
        changed = true;
      });

      if (changed) {
        const qs = params.toString();
        const newUrl = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash;
        window.history.replaceState({}, '', newUrl);
        // The banners start hidden, so the browser's own hash jump lands short.
        if (window.location.hash) {
          document.querySelector(window.location.hash)?.scrollIntoView({ block: 'start' });
        }
      }

      // Tier intent — mirrored to Meta so campaigns can optimise on it, not just GA.
      document.querySelectorAll('[data-tier-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const tier = el.getAttribute('data-tier-cta');
          if (typeof window.gtag === 'function') {
            window.gtag('event', `${tier}_cta_click`, { content_category: 'Funnel' });
          }
          if (typeof window.fbq === 'function') {
            window.fbq('trackCustom', 'TierCtaClick', { tier });
          }
        });
      });
    })();
  </script>
