---
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import Breadcrumbs from '@justinguese/astro-kit/Breadcrumbs.astro';
import SectionHeader from '@justinguese/astro-kit/SectionHeader.astro';
import ArticleGrid from '@justinguese/astro-kit/ArticleGrid.astro';
import CtaBand from '@justinguese/astro-kit/CtaBand.astro';
import { breadcrumbSchema } from '@justinguese/astro-kit/lib/seo';
import { site } from '../../config/site';
import Site from '../../layouts/Site.astro';
import { alleArtikel, artikelNachKategorie, KATEGORIEN } from '../../lib/ratgeber';
import { ratgeberHub } from '../../config/copy';

const gruppen = await artikelNachKategorie();
const artikel = await alleArtikel();

const { title, description } = ratgeberHub;

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  inLanguage: 'de-DE',
  url: `${site.url}/ratgeber/`,
  hasPart: artikel.map(a => ({
    '@type': 'Article',
    headline: a.data.title,
    description: a.data.description,
    url: `${site.url}/ratgeber/${a.id}`,
    datePublished: a.data.updated,
  })),
};

const schemas = [
  collectionSchema,
  breadcrumbSchema([
    { name: 'Start', url: `${site.url}/` },
    { name: 'Ratgeber', url: `${site.url}/ratgeber/` },
  ]),
];
---
<Site title={`${title} | ${site.name}`} description={description}>
  <Fragment slot="head">
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
    ))}
  </Fragment>

  <section class="bg-canvas border-b-[1.5px] border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <Breadcrumbs
        label="Brotkrumen"
        items={[{ label: 'Start', href: '/' }, { label: 'Ratgeber' }]}
      />

      <div class="mt-7 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8">
          <SectionHeader as="h1" size="lg" title={ratgeberHub.headline} lead={ratgeberHub.lead}>
            <span slot="eyebrow" class="tag tag-az">Praxiswissen · {artikel.length} Beiträge</span>
          </SectionHeader>
        </div>
        <div class="lg:col-span-4">
          <div class="border-[1.5px] border-ink/80 bg-canvas-deep p-6">
            <p class="font-display text-lg font-bold text-ink leading-snug">{ratgeberHub.aside.title}</p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">{ratgeberHub.aside.body}</p>
            <a
              href={ratgeberHub.aside.cta.href}
              data-cta={ratgeberHub.aside.cta.track}
              class="mt-4 inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-canvas bg-accent hover:bg-[color-mix(in_srgb,var(--color-accent)_88%,black)] transition-colors"
            >
              {ratgeberHub.aside.cta.label}
              <ArrowRight class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-2.5">
        {KATEGORIEN.map(k => (
          <a href={`#${k.slug}`} class="tag tag-az hover:border-ink hover:text-ink transition-colors">
            {k.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {gruppen.map(({ kategorie, artikel: liste }) => liste.length > 0 && (
    <section id={kategorie.slug} class="py-14 sm:py-16 border-b-[1.5px] border-line last:border-b-0 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 max-w-4xl">
          <SectionHeader as="h2" size="md" title={kategorie.label} lead={kategorie.blurb} />
          <span class="font-mono text-[11px] uppercase tracking-wider text-ink-faint shrink-0">
            {liste.length} {liste.length === 1 ? 'Beitrag' : 'Beiträge'}
          </span>
        </div>

        <div class="mt-8">
          <ArticleGrid
            columns={3}
            items={liste.map(a => ({
              href: `/ratgeber/${a.id}`,
              title: a.data.title,
              description: a.data.description,
              kicker: `${a.data.readingTime} Min. Lesezeit`,
              cta: 'Lesen',
            }))}
          />
        </div>
      </div>
    </section>
  ))}

  <CtaBand
    title={ratgeberHub.close.title}
    body={ratgeberHub.close.body}
    cta={ratgeberHub.close.cta}
    secondary={ratgeberHub.close.secondary}
  >
    <span slot="eyebrow" class="tag tag-premium">Stufe 1 · Kernleistung</span>
    <ArrowRight slot="cta-icon" class="h-4 w-4" />
  </CtaBand>

  {/*
    Tier intent is tracked site-wide by the delegated listener in
    layouts/Site.astro — this page previously carried its own copy.
  */}
</Site>
