---
import { site } from '../../config/site';
import Site from '../../layouts/Site.astro';
import { alleArtikel, artikelNachKategorie, KATEGORIEN } from '../../lib/ratgeber';

const gruppen = await artikelNachKategorie();
const artikel = await alleArtikel();

const title = 'Ratgeber: MD-Prüfungen, Fristen und Pflegedokumentation';
const description =
  'Praxiswissen für Pflegedienste, MVZ und Praxen: MD-Qualitätsprüfung, Abrechnungsprüfung nach § 275 SGB V, Fristen, Beweiskraft der Pflegedokumentation, §203 StGB und KI.';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  inLanguage: 'de-DE',
  url: `${site.url}/ratgeber/`,
  hasPart: artikel.map(a => ({
    '@type': 'Article',
    headline: a.data.title,
    description: a.data.description,
    url: `${site.url}/ratgeber/${a.id}`,
    datePublished: a.data.updated,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: `${site.url}/ratgeber/` },
  ],
};
---
<Site title={`${title} | ${site.name}`} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  </Fragment>

  <section class="bg-canvas border-b-[1.5px] border-line">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <nav aria-label="Brotkrumen" class="font-mono text-[11px] uppercase tracking-wider text-ink-faint">
        <a href="/" class="hover:text-ink">Start</a>
        <span class="mx-2 text-line">/</span>
        <span class="text-ink-soft">Ratgeber</span>
      </nav>

      <div class="mt-7 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8">
          <span class="tag tag-az">Praxiswissen · {artikel.length} Beiträge</span>
          <h1 class="mt-5 font-display text-4xl sm:text-5xl font-black tracking-[-0.02em] text-ink leading-[1.02]">
            Was Sie wissen müssen, wenn die Prüfanfrage schon auf dem Tisch liegt
          </h1>
          <p class="mt-5 text-lg text-ink-soft leading-relaxed max-w-2xl">
            Kein Lexikon, keine Rechtsberatung. Beiträge für Geschäftsführung, PDL und
            Qualitätsmanagement, die eine Anfrage von MD oder Kasse fristgerecht und
            belegbar beantworten müssen.
          </p>
        </div>
        <div class="lg:col-span-4">
          <div class="border-[1.5px] border-ink/80 bg-canvas-deep p-6">
            <p class="font-display text-lg font-bold text-ink leading-snug">
              Lieber gleich die Vorlagen?
            </p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">
              §203-Mustervereinbarung, Muster-AVV und MDR-Abgrenzungsnotiz als PDF —
              kostenlos, ohne Abo.
            </p>
            <a
              href="/#starthilfe"
              data-cta="starthilfe"
              class="mt-4 inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-canvas bg-accent hover:bg-[color-mix(in_srgb,var(--color-accent)_88%,black)] transition-colors"
            >
              Starthilfe ansehen
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-2.5">
        {KATEGORIEN.map(k => (
          <a href={`#${k.slug}`} class="tag tag-az hover:border-ink hover:text-ink transition-colors">
            {k.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {gruppen.map(({ kategorie, artikel: liste }) => liste.length > 0 && (
    <section id={kategorie.slug} class="py-14 sm:py-16 border-b-[1.5px] border-line last:border-b-0 scroll-mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 max-w-4xl">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-black tracking-tight text-ink">
              {kategorie.label}
            </h2>
            <p class="mt-2 text-ink-soft">{kategorie.blurb}</p>
          </div>
          <span class="font-mono text-[11px] uppercase tracking-wider text-ink-faint shrink-0">
            {liste.length} {liste.length === 1 ? 'Beitrag' : 'Beiträge'}
          </span>
        </div>

        <!-- Borders on the cards, not a gap over a coloured parent: the article
             count per category is not a multiple of the column count, and a
             gap-trick grid paints its leftover cells in the divider colour. -->
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 border-t-[1.5px] border-l-[1.5px] border-line">
          {liste.map(a => (
            <a
              href={`/ratgeber/${a.id}`}
              class="group bg-canvas p-6 border-r-[1.5px] border-b-[1.5px] border-line hover:bg-canvas-deep transition-colors flex flex-col"
            >
              <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">
                {a.data.readingTime} Min. Lesezeit
              </span>
              <h3 class="mt-3 font-display text-lg font-bold text-ink leading-snug group-hover:text-accent transition-colors">
                {a.data.title}
              </h3>
              <p class="mt-2.5 text-sm text-ink-soft leading-relaxed grow">
                {a.data.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-accent group-hover:gap-3 transition-all">
                Lesen
                <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="py-16 bg-ink">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="tag tag-premium">Stufe 1 · Kernleistung</span>
      <h2 class="mt-5 font-display text-3xl sm:text-4xl font-black tracking-tight text-canvas leading-tight">
        Lesen hilft. Eine fertige Antwort hilft schneller.
      </h2>
      <p class="mt-4 text-lg text-canvas/70 leading-relaxed max-w-2xl mx-auto">
        Laden Sie die geschwärzte Prüfanfrage hoch und erhalten Sie in rund 5 Werktagen
        einen Antwortentwurf mit Quellenverweisen auf Ihre eigene Dokumentation. Die
        ersten drei Fälle sind kostenlos.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/#fall-hochladen"
          data-cta="stufe1"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-canvas bg-accent hover:bg-[color-mix(in_srgb,var(--color-accent)_88%,black)] transition-colors"
        >
          Erste 3 Fälle kostenlos einreichen
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
        </a>
        <a
          href="/#preise"
          data-cta="allgemein"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-canvas border-[1.5px] border-canvas/30 hover:border-canvas transition-colors"
        >
          Preise vergleichen
        </a>
      </div>
    </div>
  </section>

  {/*
    Tier intent is tracked site-wide by the delegated listener in
    layouts/Site.astro — this page previously carried its own copy.
  */}
</Site>
