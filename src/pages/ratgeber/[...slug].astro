---
import { site } from '../../config/site';
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleLayout from '@justinguese/astro-kit/ArticleLayout.astro';
import ArrowRight from '@justinguese/astro-kit/ArrowRight.astro';
import { tocFrom } from '@justinguese/astro-kit/lib/article';
import { articleSchema, breadcrumbSchema } from '@justinguese/astro-kit/lib/seo';
import { alleArtikel, aufloesenRelated, kategorieOf, type Artikel } from '../../lib/ratgeber';
import { artikelAside, artikelDisclaimer } from '../../config/copy';

export async function getStaticPaths() {
  const artikel = await alleArtikel();
  return artikel.map(entry => ({
    params: { slug: entry.id },
    props: { entry, alle: artikel },
  }));
}

interface Props {
  entry: Artikel;
  alle: Artikel[];
}

const { entry, alle } = Astro.props;
const { Content, headings } = await render(entry);

const kategorie = kategorieOf(entry.data.category);
const related = aufloesenRelated(entry, alle);
const pfad = `/ratgeber/${entry.id}`;
const canonical = new URL(pfad, Astro.site ?? Astro.url).href;

const datumLang = new Date(entry.data.updated).toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric',
});

/**
 * Three graphs, because they answer three different questions for the crawler:
 * what is this document, where does it sit in the site, and which questions does
 * it answer outright. The FAQ is passed to ArticleLayout, which renders it
 * visibly — so the FAQPage graph is emitted there, from that same array, rather
 * than separately here.
 */
const schemas = [
  articleSchema({
    headline: entry.data.title,
    description: entry.data.description,
    url: canonical,
    datePublished: entry.data.updated,
    dateModified: entry.data.updated,
    publisher: site.name,
    section: kategorie.label,
  }),
  breadcrumbSchema([
    { name: 'Start', url: `${site.url}/` },
    { name: 'Ratgeber', url: `${site.url}/ratgeber/` },
    { name: entry.data.title, url: canonical },
  ]),
];
---
<Site
  title={`${entry.data.title} | ${site.name}`}
  description={entry.data.description}
  ogType="article"
>
  <Fragment slot="head">
    <meta name="keywords" content={entry.data.keyword} />
    <meta property="article:section" content={kategorie.label} />
    <meta property="article:modified_time" content={entry.data.updated} />
    {schemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} is:inline />
    ))}
  </Fragment>

  <ArticleLayout
    title={entry.data.title}
    description={entry.data.description}
    breadcrumbs={[
      { label: 'Start', href: '/' },
      { label: 'Ratgeber', href: '/ratgeber' },
      { label: kategorie.label },
    ]}
    breadcrumbLabel="Brotkrumen"
    meta={[`Stand ${datumLang}`, `${entry.data.readingTime} Min. Lesezeit`, kategorie.label]}
    toc={tocFrom(headings)}
    tocTitle="Inhalt"
    faq={entry.data.faq}
    faqTitle="Häufige Fragen"
    relatedTitle="Weiterlesen"
    related={related.map(a => ({
      href: `/ratgeber/${a.id}`,
      title: a.data.title,
      description: a.data.description,
      kicker: kategorieOf(a.data.category).label,
      meta: `${a.data.readingTime} Min.`,
    }))}
  >
    <span
      slot="kicker"
      class:list={['tag', `tag-${kategorie.accent === 'premium' ? 'az' : kategorie.accent}`]}
    >
      {kategorie.label}
    </span>

    <div slot="aside" class="border-[1.5px] border-accent/40 bg-canvas p-5">
      <p class="font-display text-base font-bold text-ink leading-snug">{artikelAside.title}</p>
      <p class="mt-2 text-sm text-ink-soft leading-relaxed">{artikelAside.body}</p>
      <a
        href={artikelAside.cta.href}
        data-cta={artikelAside.cta.track}
        class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:gap-3 transition-all"
      >
        {artikelAside.cta.label}
        <ArrowRight class="h-3.5 w-3.5" />
      </a>
    </div>

    <Content />

    <p
      slot="disclaimer"
      class="mt-10 max-w-3xl border-l-[3px] border-line pl-5 font-mono text-xs leading-relaxed text-ink-faint"
    >
      {artikelDisclaimer.body} <a href={artikelDisclaimer.href} class="underline hover:text-ink">{artikelDisclaimer.linkLabel}</a>.
      Stand: {datumLang}.
    </p>

    <ArticleCta slot="cta" />
  </ArticleLayout>

  <script is:inline>
    // Same success-state contract as the homepage: Formspree redirects back
    // here with ?starthilfe=1 and we reveal the download panel.
    (() => {
      const params = new URLSearchParams(window.location.search);
      if (params.get('starthilfe') !== '1') return;
      const panel = document.getElementById('starthilfe-download');
      if (panel) {
        panel.classList.remove('hidden');
        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (window.gtag) {
        window.gtag('event', 'generate_lead', {
          event_category: 'Funnel',
          event_label: 'Starthilfe (Ratgeber)',
          value: 1,
        });
      }
      if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Starthilfe (Ratgeber)' });
    })();

    // Tier intent is tracked site-wide by the delegated listener in
    // layouts/Site.astro — do not re-add one here, it would double-count.
  </script>
</Site>
