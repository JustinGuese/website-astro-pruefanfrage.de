---
import { render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import ArtikelCta from '../../components/ArtikelCta.astro';
import { alleArtikel, aufloesenRelated, kategorieOf, type Artikel } from '../../lib/ratgeber';

export async function getStaticPaths() {
  const artikel = await alleArtikel();
  return artikel.map(entry => ({
    params: { slug: entry.id },
    props: { entry, alle: artikel },
  }));
}

interface Props {
  entry: Artikel;
  alle: Artikel[];
}

const { entry, alle } = Astro.props;
const { Content, headings } = await render(entry);

const kategorie = kategorieOf(entry.data.category);
const related = aufloesenRelated(entry, alle);
const toc = headings.filter(h => h.depth === 2);
const pfad = `/ratgeber/${entry.id}`;
const canonical = new URL(pfad, Astro.site ?? Astro.url).href;

const datumLang = new Date(entry.data.updated).toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric',
});

const accentText = {
  stamp: 'text-stamp',
  file: 'text-file',
  gold: 'text-gold',
}[kategorie.accent];

/**
 * Structured data. Three graphs, because they answer three different questions
 * for the crawler: what is this document, where does it sit in the site, and
 * which questions does it answer outright. The FAQ block below renders the same
 * content visibly — invisible FAQ markup is a manual-action risk.
 */
const artikelSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  inLanguage: 'de-DE',
  datePublished: entry.data.updated,
  dateModified: entry.data.updated,
  articleSection: kategorie.label,
  keywords: entry.data.keyword,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: { '@type': 'Organization', name: 'pruefanfrage.de' },
  publisher: {
    '@type': 'Organization',
    name: 'pruefanfrage.de',
    legalName: 'DataFortress.cloud GmbH',
    url: 'https://pruefanfrage.de/',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://pruefanfrage.de/' },
    { '@type': 'ListItem', position: 2, name: 'Ratgeber', item: 'https://pruefanfrage.de/ratgeber/' },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical },
  ],
};

const faqSchema = entry.data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: entry.data.faq.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<Site
  title={`${entry.data.title} | pruefanfrage.de`}
  description={entry.data.description}
  ogType="article"
>
  <Fragment slot="head">
    <meta name="keywords" content={entry.data.keyword} />
    <meta property="article:section" content={kategorie.label} />
    <meta property="article:modified_time" content={entry.data.updated} />
    <script type="application/ld+json" set:html={JSON.stringify(artikelSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
  </Fragment>

  <div
    id="lesefortschritt"
    class="fixed top-0 left-0 right-0 z-50 h-[3px] bg-stamp origin-left scale-x-0"
    aria-hidden="true"
  ></div>

  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <nav aria-label="Brotkrumen" class="font-mono text-[11px] uppercase tracking-wider text-ink-faint">
      <a href="/" class="hover:text-ink">Start</a>
      <span class="mx-2 text-line">/</span>
      <a href="/ratgeber" class="hover:text-ink">Ratgeber</a>
      <span class="mx-2 text-line">/</span>
      <span class="text-ink-soft">{kategorie.label}</span>
    </nav>

    <div class="mt-8 grid lg:grid-cols-12 gap-10 lg:gap-14">
      <!-- Sticky table of contents. On a 1500-word page this is the difference
           between a scan and a bounce, and it hands Google a jump-link block. -->
      <aside class="lg:col-span-3 lg:order-2">
        <div class="lg:sticky lg:top-24">
          {toc.length > 2 && (
            <nav aria-label="Inhaltsverzeichnis" class="border-[1.5px] border-line bg-paper-deep p-5">
              <p class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">Inhalt</p>
              <ol class="mt-3 space-y-2.5">
                {toc.map(h => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="block text-sm leading-snug text-ink-soft hover:text-stamp transition-colors"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          <div class="mt-5 border-[1.5px] border-stamp/40 bg-paper p-5">
            <p class="font-display text-base font-bold text-ink leading-snug">
              Prüfanfrage schon auf dem Tisch?
            </p>
            <p class="mt-2 text-sm text-ink-soft leading-relaxed">
              Die ersten drei Fälle bearbeiten wir kostenlos — geschwärzt hochladen,
              Entwurf in rund 5 Werktagen.
            </p>
            <a
              href="/#fall-hochladen"
              data-tier-cta="stufe1"
              class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-stamp hover:gap-3 transition-all"
            >
              Fall einreichen
              <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <div class="lg:col-span-9 lg:order-1 min-w-0">
        <header class="max-w-3xl">
          <span class:list={['tag', `tag-${kategorie.accent === 'gold' ? 'az' : kategorie.accent}`]}>
            {kategorie.label}
          </span>
          <h1 class="mt-5 font-display text-3xl sm:text-4xl lg:text-[2.9rem] font-black tracking-[-0.02em] text-ink leading-[1.05]">
            {entry.data.title}
          </h1>
          <p class="mt-5 text-lg sm:text-xl text-ink-soft leading-relaxed">
            {entry.data.description}
          </p>
          <div class="mt-6 pt-5 border-t border-line flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-wider text-ink-faint">
            <span>Stand {datumLang}</span>
            <span class="text-line">·</span>
            <span>{entry.data.readingTime} Min. Lesezeit</span>
            <span class="text-line">·</span>
            <span class={accentText}>{kategorie.label}</span>
          </div>
        </header>

        <div class="mt-10 article-body max-w-3xl">
          <Content />
        </div>

        {entry.data.faq.length > 0 && (
          <section class="mt-16 max-w-3xl" aria-labelledby="artikel-faq">
            <h2 id="artikel-faq" class="font-display text-2xl sm:text-3xl font-black tracking-tight text-ink">
              Häufige Fragen
            </h2>
            <div class="mt-6 border-[1.5px] border-ink/80 divide-y divide-line">
              {entry.data.faq.map((f, i) => (
                <details class="group" open={i === 0}>
                  <summary class="flex items-start justify-between gap-5 cursor-pointer list-none p-5 hover:bg-paper-deep transition-colors">
                    <h3 class="font-display text-base font-bold text-ink leading-snug">{f.q}</h3>
                    <svg class="h-5 w-5 shrink-0 mt-0.5 text-stamp transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" d="M10 4v12M4 10h12" />
                    </svg>
                  </summary>
                  <p class="px-5 pb-5 -mt-1 text-ink-soft leading-relaxed">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <p class="mt-10 max-w-3xl border-l-[3px] border-line pl-5 font-mono text-xs leading-relaxed text-ink-faint">
          Dieser Beitrag beschreibt die Praxis in Pflegediensten, MVZ und Praxen und
          ersetzt keine Rechtsberatung im Sinne des RDG. Die Bewertung des Einzelfalls
          bleibt bei Ihnen oder Ihrer Rechtsberatung — <a href="/rdg-hinweis" class="underline hover:text-ink">siehe RDG-Hinweis</a>.
          Stand: {datumLang}.
        </p>

        <ArtikelCta pfad={pfad} />

        {related.length > 0 && (
          <section class="mt-16" aria-labelledby="weiterlesen">
            <h2 id="weiterlesen" class="font-display text-xl font-black tracking-tight text-ink">
              Weiterlesen
            </h2>
            <div class="mt-5 grid sm:grid-cols-3 border-t-[1.5px] border-l-[1.5px] border-line">
              {related.map(a => (
                <a href={`/ratgeber/${a.id}`} class="group bg-paper p-5 border-r-[1.5px] border-b-[1.5px] border-line hover:bg-paper-deep transition-colors flex flex-col">
                  <span class="font-mono text-[10px] uppercase tracking-widest text-ink-faint">
                    {kategorieOf(a.data.category).label}
                  </span>
                  <span class="mt-2 font-display text-base font-bold text-ink leading-snug group-hover:text-stamp transition-colors">
                    {a.data.title}
                  </span>
                  <span class="mt-2 text-sm text-ink-soft leading-relaxed line-clamp-3 grow">
                    {a.data.description}
                  </span>
                  <span class="mt-3 font-mono text-[10px] uppercase tracking-wider text-ink-faint">
                    {a.data.readingTime} Min.
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>

  <script is:inline>
    (() => {
      const bar = document.getElementById('lesefortschritt');
      if (bar) {
        const update = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
      }

      // Same success-state contract as the homepage: Formspree redirects back
      // here with ?starthilfe=1 and we reveal the download panel.
      const params = new URLSearchParams(window.location.search);
      if (params.get('starthilfe') === '1') {
        const panel = document.getElementById('starthilfe-download');
        if (panel) {
          panel.classList.remove('hidden');
          panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (window.gtag) {
          window.gtag('event', 'generate_lead', {
            event_category: 'Funnel',
            event_label: 'Starthilfe (Ratgeber)',
            value: 1,
          });
        }
        if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Starthilfe (Ratgeber)' });
      }

      document.querySelectorAll('[data-tier-cta]').forEach((el) => {
        el.addEventListener('click', () => {
          const tier = el.getAttribute('data-tier-cta');
          if (window.gtag) {
            window.gtag('event', 'tier_cta_click', { event_category: 'Funnel', event_label: tier });
          }
          if (window.fbq) window.fbq('trackCustom', 'TierCtaClick', { tier });
        });
      });
    })();
  </script>
</Site>
